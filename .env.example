# Copy to .env.local at the repo root (gitignored) and fill in. `pnpm env:check` lists what is missing.

# Privy app id (dashboard), exposed to the browser
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: a Privy test account (Dashboard > User management > Authentication > Advanced) shown on the
# publisher and advertiser sign-in screens; both must be set. Exposed to the browser
# NEXT_PUBLIC_DEMO_LOGIN_EMAIL=
# NEXT_PUBLIC_DEMO_LOGIN_CODE=
# Privy app secret, server only
PRIVY_APP_SECRET=
# Privy authorization key that signs server-wallet requests
PRIVY_AUTHORIZATION_KEY=

# Moonshot (KIMI) API key; without it the web app runs the dev-only stub model
KIMI_API_KEY=
# OpenAI-compatible base URL, e.g. https://api.moonshot.ai/v1
KIMI_BASE_URL=
# Model id as listed by GET {KIMI_BASE_URL}/models
KIMI_MODEL=
# Optional: KIMI request starts per rolling minute and requests in flight; raise them on a higher-tier account
# KIMI_RPM=3
# KIMI_CONCURRENCY=1

# Aria serve API key (Bearer), shared by Nova's SDK client and the serve route; any long random string,
# e.g. ak_test_ + 32 letters and digits. Outside production a built-in dev key is used when it is empty
ARIA_API_KEY=
# Secret that signs impression tokens (HMAC); any long random string. Outside production a dev secret is used
ARIA_TOKEN_SECRET=
# Optional: Gemini picks the ad in the serve API; without a key it picks by campaign keywords
# GEMINI_API_KEY=
# Gemini model id (default gemini-3.6-flash)
# GEMINI_MODEL=
# OpenAI-compatible Gemini base URL (default https://generativelanguage.googleapis.com/v1beta/openai/)
# GEMINI_BASE_URL=
# Publisher id Nova sends and the serve API accepts (default pub_nova)
# ARIA_PUBLISHER_ID=
# Aria API base URL Nova's SDK calls (default http://127.0.0.1:$PORT/api, this same server)
# ARIA_BASE_URL=
# Public origin for click, why and beacon URLs in served ads (default: the request's origin)
# ARIA_PUBLIC_URL=
# Nova's budget for one serve call in ms (default 6000)
# ARIA_SERVE_TIMEOUT_MS=

# Envio hosted API token for the indexer
ENVIO_API_TOKEN=
# Indexer GraphQL (Hasura) endpoint read by the web app
ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql

# Monad testnet JSON-RPC URL
MONAD_TESTNET_RPC_URL=
# Monad testnet chain id: 10143
NEXT_PUBLIC_CHAIN_ID=
# Deployed AriaClearing address
NEXT_PUBLIC_CLEARING_ADDRESS=
# Settlement token (testnet USDC)
USDC_ADDRESS=
# Privy server wallet that sends logEvent
RELAYER_ADDRESS=
# CRE forwarder allowed to call onReport (testnet MockKeystoneForwarder)
FORWARDER_ADDRESS=
# Dispute window in seconds, passed to the constructor
DISPUTE_WINDOW=

# Throwaway deployer key and address
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Throwaway key CRE uses to broadcast reports, and its address
CRE_ETH_PRIVATE_KEY=
CRE_SENDER_ADDRESS=

# Fallback publisher until one logs into /dashboard
PUBLISHER_ADDRESS=

# Optional (commented out so env:check skips them); uncomment to use.
# Directory for events.json, campaigns.json and publisher.json (default web/.data)
# ARIA_DATA_DIR=
# Per-file overrides of the stores above
# ARIA_EVENTS_FILE=
# ARIA_CAMPAIGNS_FILE=
# ARIA_PUBLISHER_FILE=
# When set, the debug bar opens only with /?debug=<key> and demo-control routes need the key
# ARIA_DEMO_KEY=
# Largest budget in US dollars per console campaign; the demo key skips it
# ARIA_LAUNCH_MAX_USD=
# Console launches allowed per signed-in advertiser; the demo key skips it
# ARIA_LAUNCH_PER_USER=
# Who funds console campaigns: wallet (the advertiser's Privy embedded wallet) or treasury (default)
# ADVERTISER_FUNDING=
# Test funds sends per signed-in advertiser in wallet mode (default 1); the demo key skips it
# ARIA_TEST_FUNDS_PER_USER=
