# Copy to .env.local at the repo root (gitignored) and fill in. `pnpm env:check` lists what is missing.

# Privy app id (dashboard), exposed to the browser
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy app secret, server only
PRIVY_APP_SECRET=
# Privy authorization key that signs server-wallet requests
PRIVY_AUTHORIZATION_KEY=

# Moonshot (KIMI) API key; without it the web app runs the dev-only stub model
KIMI_API_KEY=
# OpenAI-compatible base URL, e.g. https://api.moonshot.ai/v1
KIMI_BASE_URL=
# Model id as listed by GET {KIMI_BASE_URL}/models
KIMI_MODEL=

# Envio hosted API token for the indexer
ENVIO_API_TOKEN=
# Indexer GraphQL (Hasura) endpoint read by the web app
ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql

# Monad testnet JSON-RPC URL
MONAD_TESTNET_RPC_URL=
# Monad testnet chain id: 10143
NEXT_PUBLIC_CHAIN_ID=
# Deployed AriaClearing address
NEXT_PUBLIC_CLEARING_ADDRESS=
# Settlement token (testnet USDC)
USDC_ADDRESS=
# Privy server wallet that sends logEvent
RELAYER_ADDRESS=
# CRE forwarder allowed to call onReport (testnet MockKeystoneForwarder)
FORWARDER_ADDRESS=
# Dispute window in seconds, passed to the constructor
DISPUTE_WINDOW=

# Throwaway deployer key and address
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Throwaway key CRE uses to broadcast reports, and its address
CRE_ETH_PRIVATE_KEY=
CRE_SENDER_ADDRESS=

# Fallback publisher until one logs into /dashboard
PUBLISHER_ADDRESS=
